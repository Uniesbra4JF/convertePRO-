{
  "appId": "com.convertepro.app",
  "appName": "ConvertePRO+",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "ios": {
    "scheme": "ConvertePRO",
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#f8f9fc",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
